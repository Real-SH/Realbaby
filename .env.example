# Preview: keep indexing disabled. At domain launch, set the final URL and true.
NEXT_PUBLIC_SITE_URL=https://realbaby.vercel.app
NEXT_PUBLIC_ALLOW_INDEXING=false

# Inquiry delivery
INQUIRY_TARGET_EMAIL=real@realbaby.cn
INQUIRY_FROM_EMAIL=Realbaby Website <website@realbabytoy.com>
RESEND_API_KEY=
INQUIRY_FORWARD_WEBHOOK_URL=
# Optional local/server storage fallback. Do not rely on this on Vercel.
INQUIRY_STORAGE_DIR=
